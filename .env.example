# Environment Variables (DO NOT commit this to git)
# Copy this to .env and fill in your values

# LM Studio local server URL
LMSTUDIO_URL=http://localhost:1234/v1

# Optional: Cloud API fallback (if LM Studio goes down)
OPENAI_API_KEY=your_openai_key_here

# Profanity filter words file path
PROFANITY_FILE=./config/profanity_words.txt
